				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>for d in "$HOME/.local/bin" /opt/homebrew/bin /usr/local/bin; do
  [ -x "$d/mbincompiler" ] &amp;&amp; export PATH="$d:$PATH"
done
if ! command -v mbincompiler &gt;/dev/null 2&gt;&amp;1; then
  osascript -e 'display dialog "MBINCompiler is not on your PATH. Run install.sh from the MBINCompiler download first, then try again." buttons {"OK"} default button "OK" with icon stop with title "MBINCompiler"'
  exit 1
fi
ok=0; fail=0
for f in "$@"; do
  if mbincompiler -y -f "$f"; then ok=$((ok+1)); else fail=$((fail+1)); fi
done
osascript -e "display notification \"$ok converted, $fail failed.\" with title \"MBINCompiler\""</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>

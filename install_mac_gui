#!/bin/bash
# install_mac_gui — build & install the MBINCompiler macOS app, or manage it afterwards.
# (macOS / Apple Silicon only — the GUI is a SwiftUI app.)
#
#   ./install_mac_gui          raw checkout → signed app in ~/Applications (+ the
#                              'mbincompiler' command on your PATH)
#   ./install_mac_gui mbincompiler   same as above
#   mbincompiler update        pull the latest from GitHub, rebuild, swap the live app
#   mbincompiler run           launch the installed app
#   mbincompiler cli           build just the standalone command-line tool
#
# The app is a SwiftUI front-end (macos-app/) that shells out to a self-contained
# .NET 8 build of MBINCompiler embedded inside the bundle, so the installed app
# needs no .NET runtime of its own. BUILDING it needs the .NET SDK + Xcode CLT.
#
# Once installed it is symlinked onto your PATH as the `mbincompiler` command,
# which runs this same script for update/run/cli.
set -euo pipefail

# Resolve symlinks (the PATH install is a symlink to this script) so REPO is the real checkout.
SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
    SRC_DIR="$(cd "$(dirname "$SRC")" && pwd)"
    SRC="$(readlink "$SRC")"
    [[ "$SRC" != /* ]] && SRC="$SRC_DIR/$SRC"
done
REPO="$(cd "$(dirname "$SRC")" && pwd)"
SELF="$REPO/install_mac_gui"

APP_NAME="MBINCompiler"
PRODUCT="MBINCompilerGUI"
RID="osx-arm64"
APP_DIR="$HOME/Applications"
APP="$APP_DIR/$APP_NAME.app"
SWIFT_DIR="$REPO/macos-app"
PUBLISH_DIR="$SWIFT_DIR/.build/mbincompiler-net"   # self-contained .NET publish
STAGE="$SWIFT_DIR/.build/dist/$APP_NAME.app"
BOLD=$'\033[1m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; RESET=$'\033[0m'

say()  { echo "${BOLD}${GREEN}==>${RESET}${BOLD} $*${RESET}"; }
warn() { echo "${BOLD}${YELLOW}warning:${RESET} $*"; }
die()  { echo "${BOLD}error:${RESET} $*" >&2; exit 1; }

need_macos() {
    [ "$(uname -s)" = "Darwin" ] || die "install_mac_gui only builds the macOS app. On Windows/Linux use the command-line build scripts (see the README)."
}
need_swift() {
    # `command -v swift` always succeeds on macOS (the OS ships a shim); gate on the real toolchain.
    xcode-select -p >/dev/null 2>&1 || die "Xcode command-line tools not found. Install them with:  xcode-select --install"
}
need_dotnet() {
    command -v dotnet >/dev/null 2>&1 || die "The .NET SDK was not found. Install .NET 8 (or newer) from https://dotnet.microsoft.com/download — e.g.  brew install --cask dotnet-sdk"
}

# spin "label" cmd...   — run a long command with a spinner + last log line (plain passthrough when not a TTY).
spin() {
    local label="$1"; shift
    say "$label"
    if [ ! -t 1 ]; then "$@"; return; fi
    local log; log="$(mktemp /tmp/mbincompiler-build.XXXXXX)"
    ( "$@" >"$log" 2>&1 ) & local pid=$!
    trap 'kill "$pid" 2>/dev/null; printf "\r\033[K"; exit 130' INT TERM
    local frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏' i=0 start=$SECONDS
    while kill -0 "$pid" 2>/dev/null; do
        printf '\r\033[K  %s%s%s %3ds  %.66s' "$GREEN" "${frames:$((i % 10)):1}" "$RESET" "$((SECONDS - start))" "$(tail -n 1 "$log" 2>/dev/null | tr -d '\r')"
        i=$((i + 1)); sleep 0.12
    done
    trap - INT TERM
    printf '\r\033[K'
    if wait "$pid"; then echo "  ${GREEN}✓${RESET} done in $((SECONDS - start))s"; rm -f "$log"
    else cat "$log"; rm -f "$log"; die "step failed — full output above"; fi
}

build_dotnet() {
    need_dotnet
    rm -rf "$PUBLISH_DIR"
    spin "Building MBINCompiler (.NET, self-contained $RID)…" \
        dotnet publish "$REPO/MBINCompiler" -c Release -f net8.0 -r "$RID" \
            --self-contained true -p:PublishSingleFile=false \
            -o "$PUBLISH_DIR" /nowarn:cs0618 /nowarn:cs0169 /nowarn:cs0414
    [ -x "$PUBLISH_DIR/MBINCompiler" ] || die "expected $PUBLISH_DIR/MBINCompiler after publish"
}

build_app() {
    need_swift
    spin "Building $APP_NAME GUI (Swift, release)…" \
        swift build --package-path "$SWIFT_DIR" -c release --product "$PRODUCT"
}

make_icon() {
    [ -f "$SWIFT_DIR/packaging/AppIcon.icns" ] && { cp "$SWIFT_DIR/packaging/AppIcon.icns" "$STAGE/Contents/Resources/"; return 0; }
    command -v iconutil >/dev/null 2>&1 || return 0
    say "Generating app icon…"
    local tmp; tmp="$(mktemp -d)"
    if ! swift "$SWIFT_DIR/packaging/GenerateIcon.swift" "$tmp/icon_1024.png" >/dev/null 2>&1; then
        warn "icon generation failed — installing without a custom icon"; rm -rf "$tmp"; return 0
    fi
    local set="$tmp/AppIcon.iconset"; mkdir -p "$set"
    for s in 16 32 64 128 256 512; do
        sips -z $s $s "$tmp/icon_1024.png" --out "$set/icon_${s}x${s}.png" >/dev/null 2>&1
        sips -z $((s*2)) $((s*2)) "$tmp/icon_1024.png" --out "$set/icon_${s}x${s}@2x.png" >/dev/null 2>&1
    done
    iconutil -c icns "$set" -o "$tmp/AppIcon.icns" >/dev/null 2>&1 && cp "$tmp/AppIcon.icns" "$STAGE/Contents/Resources/AppIcon.icns"
    rm -rf "$tmp"
}

# Stamp the bundle's version to match the embedded MBINCompiler build, so the app
# version always tracks libMBIN's VERSION_STRING rather than drifting.
stamp_version() {
    local full short
    full="$("$PUBLISH_DIR/MBINCompiler" version -q 2>/dev/null | tr -d ' \r\n')"   # e.g. 6.45.0.1
    if [[ "$full" =~ ^[0-9]+(\.[0-9]+){1,3}$ ]]; then
        short="$(echo "$full" | cut -d. -f1-3)"                                     # 6.45.0 (Apple wants ≤3 ints)
        /usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString $short" "$STAGE/Contents/Info.plist" >/dev/null 2>&1
        /usr/libexec/PlistBuddy -c "Set :CFBundleVersion $full" "$STAGE/Contents/Info.plist" >/dev/null 2>&1
        say "App version stamped: $short (build $full)"
    else
        warn "couldn't read MBINCompiler version — leaving Info.plist version unchanged"
    fi
}

bundle() {
    say "Assembling $APP_NAME.app…"
    rm -rf "$STAGE"
    mkdir -p "$STAGE/Contents/MacOS" "$STAGE/Contents/Resources/mbincompiler"
    cp "$SWIFT_DIR/packaging/Info.plist" "$STAGE/Contents/Info.plist"
    cp "$SWIFT_DIR/.build/release/$PRODUCT" "$STAGE/Contents/MacOS/$APP_NAME"
    stamp_version
    cp -R "$PUBLISH_DIR/." "$STAGE/Contents/Resources/mbincompiler/"
    chmod +x "$STAGE/Contents/Resources/mbincompiler/MBINCompiler"
    make_icon
    # Ad-hoc signature so Gatekeeper lets a locally-built app run.
    codesign --force --deep --sign - "$STAGE" >/dev/null 2>&1 || warn "codesign failed — the app may trip Gatekeeper"
}

deploy() {
    say "Installing to ${APP} …"
    mkdir -p "$APP_DIR"
    rm -rf "$APP"
    cp -R "$STAGE" "$APP"
}

link_cli() {
    for bin in /opt/homebrew/bin /usr/local/bin; do
        if [ -d "$bin" ] && [ -w "$bin" ]; then
            ln -sf "$SELF" "$bin/mbincompiler"
            say "CLI linked: ${bin}/mbincompiler → run 'mbincompiler update' from anywhere"
            return
        fi
    done
    warn "couldn't find a writable bin dir — manage it via $SELF (or add the repo to your PATH)"
}

cmd_install() {
    need_macos
    build_dotnet
    build_app
    bundle
    deploy
    rm -rf "$SWIFT_DIR/.build/dist"   # Spotlight indexes the staging copy → duplicate in Launchpad
    link_cli
    say "Done. Launch with:  mbincompiler run   (or open $APP)"
}

cmd_update() {
    [ -d "$REPO/.git" ] || die "$REPO is not a git checkout — re-clone, or just run: ./install_mac_gui"
    say "Pulling latest…"
    (cd "$REPO" && git pull --ff-only) || die "git pull failed — commit/stash local changes first"
    exec "$SELF" mbincompiler
}

cmd_cli() {
    need_macos
    build_dotnet
    say "Command-line tool built at: $PUBLISH_DIR/MBINCompiler"
    say "Try it with:  $PUBLISH_DIR/MBINCompiler help"
}

cmd_run()  { open "$APP" 2>/dev/null || die "$APP_NAME isn't installed yet — run: ./install_mac_gui"; }

usage() {
    echo "${BOLD}install_mac_gui${RESET} — one-command install for the MBINCompiler macOS app"
    echo
    echo "  ./install_mac_gui        build from source and install $APP"
    echo "  mbincompiler update      pull the latest version and update the live app"
    echo "  mbincompiler run         launch MBINCompiler"
    echo "  mbincompiler cli         build just the standalone command-line tool"
}

# Default verb: bare `./install_mac_gui` installs; the PATH-linked `mbincompiler` prints help.
verb="${1:-}"
if [ -z "$verb" ]; then
    [ "$(basename "$0")" = "install_mac_gui" ] && verb="install" || verb="help"
fi
case "$verb" in
    install|mbincompiler) cmd_install ;;
    update)               cmd_update ;;
    run)                  cmd_run ;;
    cli)                  cmd_cli ;;
    *)                    usage ;;
esac
